{
  "$schema": "https://opencode.ai/config.json",

  "model": "openai/gpt-6.1-sol",
  "small_model": "opencode-go/minimax-m3",
  "plugins": [
    "./plugins/astgrep",
    "./plugins/search-tool-guard",
    "./plugins/session-retro",
    "./plugins/herdr-agent-state",
    "./plugins/nono-sandbox"
  ],

  // MCP tools stay globally OFF the default agent context; specific agents opt
  // back in below. MCP servers still connect on startup (enabled: true).
  "tools": {
    "context7*": false
  },

  "agents": {
    "build": {
      "mode": "all",
      "system": "{file:./prompts/build.md}",
      "model": "openai/gpt-5.6-terra",
      "permissions": [
        { "action": "sentry_*", "resource": "*", "effect": "deny" },
        { "action": "grep", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "indexer", "effect": "allow" },
        { "action": "subagent", "resource": "docs", "effect": "allow" },
        { "action": "subagent", "resource": "browser", "effect": "allow" },
        { "action": "subagent", "resource": "build", "effect": "allow" }
      ]
    }
  },

  "agent": {
    "docs": {
      "mode": "subagent",
      "prompt": "{file:./prompts/docs.md}",
      "model": "opencode-go/minimax-m3",
      "tools": {
        "context7*": true,
        "exa*": true,
      },
    },
    "browser": {
      "description": "Investigates browser-only UI behavior with Playwriter in the user's existing Chrome and returns reproduction steps and evidence without editing code.",
      "mode": "subagent",
      "prompt": "{file:./prompts/browser.md}",
      "model": "opencode-go/minimax-m3",
      "permission": {
        "read": "deny",
        "bash": {
          "*": "deny",
          "playwriter *": "allow",
          "npx playwriter@latest *": "allow",
          "bunx playwriter@latest *": "allow",
        },
        "grep": "deny",
      },
    },
    "triaging": {
      "description": "Investigates production issues with Sentry access. Use when debugging incidents, errors, traces, logs, monitors, service health, or observability questions.",
      "prompt": "{file:./prompts/build.md}",
      "model": "openai/gpt-6.1-sol",
      "tools": {
        "sentry_*": true,
      },
      "permission": {
        "grep": "deny",
        "task": {
          "*": "deny",
          "indexer": "allow",
          "docs": "allow",
          "browser": "allow",
        },
      },
    },
    "indexer": {
      "mode": "subagent",
      "model": "opencode-go/minimax-m3",
      "prompt": "{file:./prompts/indexer.md}"
    },
    "structural-indexer": {
      "description": "Performs structural code search with ast-grep, including call relationships, containment, missing constructs, and repeated code shapes.",
      "mode": "subagent",
      "prompt": "{file:./prompts/structural-indexer.md}",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "grep": "deny",
        "glob": "allow"
      }
    }
  },
}
